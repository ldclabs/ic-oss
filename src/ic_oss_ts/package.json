{
  "name": "@ldclabs/ic_oss_ts",
  "version": "1.4.0",
  "type": "module",
  "description": "The Typescript version of the client SDK for the ic-oss cluster.",
  "license": "MIT",
  "homepage": "https://github.com/ldclabs/ic-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldclabs/ic-oss.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "browser": {
    "node:fs/promises": false,
    "node:path": false,
    "mime/lite": false
  },
  "files": [
    "candid",
    "dist",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "dfx generate && rm -rf candid && cp -r '../declarations' './candid'",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\"",
    "test": "vitest run",
    "ncu": "npx npm-check-updates -u",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@icp-sdk/core": "^6.1.0",
    "@noble/hashes": "^2.4.0",
    "mime": "^4.1.0",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}