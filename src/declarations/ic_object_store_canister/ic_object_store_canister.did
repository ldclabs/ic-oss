type Attribute = variant {
  ContentType;
  Metadata : text;
  ContentEncoding;
  ContentLanguage;
  CacheControl;
  ContentDisposition;
};
type Error = variant {
  // Error when the object at the location isn't modified
  NotModified : record {
    // The path to the file
    path : text;
    // The wrapped error
    error : text;
  };
  // Error when a configuration key is invalid for the store used
  UnknownConfigurationKey : record {
    // The configuration key used
    key : text;
  };
  // Error when the object is not found at given location
  NotFound : record {
    // The path to file
    path : text;
  };
  // Error when the used credentials don't have enough permission
  // to perform the requested operation
  PermissionDenied : record {
    // The path to the file
    path : text;
    // The wrapped error
    error : text;
  };
  // A fallback error type when no variant matches
  Generic : record {
    // The wrapped error
    error : text;
  };
  // Error when the object already exists
  AlreadyExists : record {
    // The path to the
    path : text;
  };
  // Error for invalid path
  InvalidPath : record {
    // The wrapped error
    path : text;
  };
  // Error when the attempted operation is not supported
  NotSupported : record {
    // The wrapped error
    error : text;
  };
  // Error when the required conditions failed for the operation
  Precondition : record {
    // The path to the file
    path : text;
    // The wrapped error
    error : text;
  };
  // Error when an operation is not implemented
  // Error when an operation is not implemented
  NotImplemented : record {
    // Which driver this is that hasn't implemented this operation,
    // to aid debugging in contexts that may be using multiple implementations.
    implementer : text;
    // What isn't implemented. Should include at least the method
    // name that was called; could also include other relevant
    // subcontexts.
    operation : text;
  };
  // Error when the used credentials lack valid authentication
  Unauthenticated : record {
    // The path to the file
    path : text;
    // The wrapped error
    error : text;
  };
};
type GetOptions = record {
  // Request will succeed if the `ObjectMeta::e_tag` matches
  // otherwise returning [`Error::Precondition`]
  // 
  // See <https://datatracker.ietf.org/doc/html/rfc9110#name-if-match>
  // 
  // Examples:
  // 
  // ```text
  // If-Match: "xyzzy"
  // If-Match: "xyzzy", "r2d2xxxx", "c3piozzzz"
  // If-Match: *
  // ```
  if_match : opt text;
  // Request will succeed if the object has not been modified since
  // otherwise returning [`Error::Precondition`]
  // 
  // Some stores, such as S3, will only return `NotModified` for exact
  // timestamp matches, instead of for any timestamp greater than or equal.
  // 
  // <https://datatracker.ietf.org/doc/html/rfc9110#section-13.1.4>
  if_unmodified_since : opt nat64;
  // Request transfer of no content
  // 
  // <https://datatracker.ietf.org/doc/html/rfc9110#name-head>
  head : bool;
  // Request will succeed if the object has been modified since
  // 
  // <https://datatracker.ietf.org/doc/html/rfc9110#section-13.1.3>
  if_modified_since : opt nat64;
  // Request a particular object version
  version : opt text;
  // Request will succeed if the `ObjectMeta::e_tag` does not match
  // otherwise returning [`Error::NotModified`]
  // 
  // See <https://datatracker.ietf.org/doc/html/rfc9110#section-13.1.2>
  // 
  // Examples:
  // 
  // ```text
  // If-None-Match: "xyzzy"
  // If-None-Match: "xyzzy", "r2d2xxxx", "c3piozzzz"
  // If-None-Match: *
  // ```
  if_none_match : opt text;
  // Request transfer of only the specified range of bytes
  // otherwise returning [`Error::NotModified`]
  // 
  // <https://datatracker.ietf.org/doc/html/rfc9110#name-range>
  range : opt GetRange;
};
type GetRange = variant {
  // Request all bytes starting from a given byte offset
  Offset : nat64;
  // Request a specific range of bytes
  // 
  // If the given range is zero-length or starts after the end of the object,
  // an error will be returned. Additionally, if the range ends after the end
  // of the object, the entire remainder of the object will be returned.
  // Otherwise, the exact requested range will be returned.
  Bounded : record { nat64; nat64 };
  // Request up to the last n bytes
  Suffix : nat64;
};
type GetResult = record {
  meta : ObjectMeta;
  attributes : vec record { Attribute; text };
  range : record { nat64; nat64 };
  payload : blob;
};
type InitArgs = record { governance_canister : opt principal; name : text };
type InstallArgs = variant { Upgrade : UpgradeArgs; Init : InitArgs };
type ListResult = record {
  // Prefixes that are common (like directories)
  common_prefixes : vec text;
  // Object metadata for the listing
  objects : vec ObjectMeta;
};
type ObjectMeta = record {
  // A set of tags with AES256-GCM encryption
  // Each part of the object has its own tag
  aes_tags : opt vec blob;
  // The size in bytes of the object
  size : nat64;
  // The unique identifier for the object
  // 
  // <https://datatracker.ietf.org/doc/html/rfc9110#name-etag>
  e_tag : opt text;
  // A version indicator for this object
  version : opt text;
  // The last modified time
  last_modified : nat64;
  // A nonce with AES256-GCM encryption
  aes_nonce : opt blob;
  // The full path to the object
  location : text;
};
type PartId = record {
  // Id of this part
  content_id : text;
};
type PutMode = variant {
  // Perform an atomic write operation, overwriting any object present at the provided path
  Overwrite;
  // Perform an atomic write operation, returning [`Error::AlreadyExists`] if an
  // object already exists at the provided path
  Create;
  // Perform an atomic write operation if the current version of the object matches the
  // provided [`UpdateVersion`], returning [`Error::Precondition`] otherwise
  Update : UpdateVersion;
};
type PutMultipartOptions = record {
  // A set of tags with AES256-GCM encryption
  // Each part of the object has its own tag
  aes_tags : opt vec blob;
  // Provide a [`TagSet`] for this object
  // 
  // Implementations that don't support object tagging should ignore this
  tags : text;
  // Provide a set of [`Attributes`]
  // 
  // Implementations that don't support an attribute should return an error
  attributes : vec record { Attribute; text };
  // A nonce with AES256-GCM encryption
  aes_nonce : opt blob;
};
type PutOptions = record {
  // A set of tags with AES256-GCM encryption
  // Each part of the object has its own tag
  aes_tags : opt vec blob;
  // Configure the [`PutMode`] for this operation
  mode : PutMode;
  // Provide a [`TagSet`] for this object
  // 
  // Implementations that don't support object tagging should ignore this
  tags : text;
  // Provide a set of [`Attributes`]
  // 
  // Implementations that don't support an attribute should return an error
  attributes : vec record { Attribute; text };
  // A nonce with AES256-GCM encryption
  aes_nonce : opt blob;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok; Err : text };
type Result_10 = variant { Ok : vec ObjectMeta; Err : Error };
type Result_11 = variant { Ok : ListResult; Err : Error };
type Result_12 = variant { Ok : PartId; Err : Error };
type Result_13 = variant { Ok : text; Err : text };
type Result_2 = variant { Ok : UpdateVersion; Err : Error };
type Result_3 = variant { Ok : text; Err : Error };
type Result_4 = variant { Ok : GetResult; Err : Error };
type Result_5 = variant { Ok : blob; Err : Error };
type Result_6 = variant { Ok : vec blob; Err : Error };
type Result_7 = variant { Ok : StateInfo; Err : text };
type Result_8 = variant { Ok : ObjectMeta; Err : Error };
type Result_9 = variant { Ok : bool; Err : text };
type StateInfo = record {
  next_etag : nat64;
  managers : vec principal;
  governance_canister : opt principal;
  name : text;
  auditors : vec principal;
  objects : nat64;
};
type UpdateVersion = record {
  // The unique identifier for the newly created object
  // 
  // <https://datatracker.ietf.org/doc/html/rfc9110#name-etag>
  e_tag : opt text;
  // A version indicator for the newly created object
  version : opt text;
};
type UpgradeArgs = record {
  governance_canister : opt principal;
  name : opt text;
};
service : (opt InstallArgs) -> {
  abort_multipart : (text, text) -> (Result);
  admin_add_auditors : (vec principal) -> (Result_1);
  admin_add_managers : (vec principal) -> (Result_1);
  admin_clear : () -> (Result_1);
  admin_remove_auditors : (vec principal) -> (Result_1);
  admin_remove_managers : (vec principal) -> (Result_1);
  complete_multipart : (text, text, PutMultipartOptions) -> (Result_2);
  copy : (text, text) -> (Result);
  copy_if_not_exists : (text, text) -> (Result);
  create_multipart : (text) -> (Result_3);
  delete : (text) -> (Result);
  get_opts : (text, GetOptions) -> (Result_4) query;
  get_part : (text, nat64) -> (Result_5) query;
  get_ranges : (text, vec record { nat64; nat64 }) -> (Result_6) query;
  get_state : () -> (Result_7) query;
  head : (text) -> (Result_8) query;
  is_member : (text, principal) -> (Result_9) query;
  list : (opt text) -> (Result_10) query;
  list_with_delimiter : (opt text) -> (Result_11) query;
  list_with_offset : (opt text, text) -> (Result_10) query;
  put_opts : (text, blob, PutOptions) -> (Result_2);
  put_part : (text, text, nat64, blob) -> (Result_12);
  rename : (text, text) -> (Result);
  rename_if_not_exists : (text, text) -> (Result);
  validate_admin_add_auditors : (vec principal) -> (Result_13);
  validate_admin_add_managers : (vec principal) -> (Result_13);
  validate_admin_clear : () -> (Result_13);
  validate_admin_remove_auditors : (vec principal) -> (Result_13);
  validate_admin_remove_managers : (vec principal) -> (Result_13);
}
